#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Brings the settings of an older version to the current format (option
# "version"). OpenWrt keeps a changed /etc/config/mynetworkmonitor on update, so
# new options must be added here. Runs once after installing or updating.

version=$(uci -q get mynetworkmonitor.scan.version)

# Format 1 had one field "targets"; format 2 has the router networks as a list
# and own ranges apart. A former range becomes an own range, nothing is lost.
if [ "$version" = "1" ]; then
	targets=$(uci -q get mynetworkmonitor.scan.targets)
	uci -q delete mynetworkmonitor.scan.targets
	[ -n "$targets" ] && uci set mynetworkmonitor.scan.ranges="$targets"
	uci -q get mynetworkmonitor.scan.networks >/dev/null || uci add_list mynetworkmonitor.scan.networks='lan'
	uci -q get mynetworkmonitor.scan.persist >/dev/null || uci set mynetworkmonitor.scan.persist='0'
	uci set mynetworkmonitor.scan.version='2'
	uci commit mynetworkmonitor
	version=2
fi

# Format 3 chooses services in groups instead of one port list.
if [ "$version" = "2" ]; then
	uci -q delete mynetworkmonitor.scan.ports
	uci -q get mynetworkmonitor.scan.extra_ports >/dev/null || uci set mynetworkmonitor.scan.extra_ports=''
	uci set mynetworkmonitor.scan.version='3'
	uci commit mynetworkmonitor
	version=3
fi

# Format 4 adds "Names from DNS", on by default: a choice saved before it
# existed gets it once.
if [ "$version" = "3" ]; then
	if [ "$(uci -q get mynetworkmonitor.scan.services_chosen)" = "1" ]; then
		uci -q get mynetworkmonitor.scan.services | grep -qw dnsnames || uci add_list mynetworkmonitor.scan.services='dnsnames'
	fi
	uci set mynetworkmonitor.scan.version='4'
	uci commit mynetworkmonitor
fi

# No choice of services yet (new installation, or format 2 above): take the
# defaults from the catalog, the only place where they are written down.
# "services_chosen" is set once the user saved a choice - also an empty one,
# which must stay empty.
if [ "$(uci -q get mynetworkmonitor.scan.services_chosen)" != "1" ] && ! uci -q get mynetworkmonitor.scan.services >/dev/null; then
	for s in $(jsonfilter -i /usr/share/mynetworkmonitor/services.json -e '@.groups[*].items[@.default=true].id'); do
		uci add_list mynetworkmonitor.scan.services="$s"
	done
	uci commit mynetworkmonitor
fi

exit 0
